{
  "name": "ka-crystal-reconstruction",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "KA portfolio + store: Cloudflare Workers, D1 (SQLite), R2 storage, Cloudflare Pages.",
  "scripts": {
    "prestart": "npm run build:assets",
    "start": "node server/platform/node-dev.js",
    "dev": "npm start",
    "build:assets": "node generator/scripts/verify_scripts.cjs && tsc --noEmit && vite build --configLoader runner && node generator/scripts/verify_startup.cjs && node scripts/stage-pages.mjs",
    "build": "npm run build:assets && node --test tests/gallery-build.test.mjs tests/delivery.test.mjs",
    "ci": "npm run build && npm test",
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\" && node generator/scripts/verify_ui.cjs",
    "db:import-legacy": "node scripts/import-legacy.mjs",
    "db:seed-demo": "node scripts/seed-demo.mjs",
    "build:cf": "npm run build:assets",
    "cf:dev": "npm run build:cf && wrangler dev",
    "cf:migrate": "wrangler d1 migrations apply ka-db --remote",
    "cf:deploy": "npm run build:cf && wrangler d1 migrations apply ka-db --remote && wrangler deploy && node scripts/deploy-pages.mjs",
    "docker:build": "docker build -t ka-site .",
    "docker:up": "docker compose up --build",
    "cf:upload-files": "node scripts/upload-files-to-r2.mjs",
    "cf:deploy-pages": "node scripts/deploy-pages.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "dotenv": "^16.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "ua-parser-js": "1.0.41"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.185.4",
    "better-sqlite3": "^11.10.0",
    "postcss": "8.5.28",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "wrangler": "^4.144.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
