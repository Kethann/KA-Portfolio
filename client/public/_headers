# Cloudflare static-asset headers (copied to dist/ by Vite). "! Name" removes a header set by a broader rule.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=(self "https://checkout.razorpay.com" "https://api.razorpay.com"), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# the homepage: always checked, so a new deploy shows at once (unchanged = a tiny 304)
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# fingerprinted build files never change
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# the five lazily loaded entry files keep fixed names, so they are rechecked instead
/assets/gallery.js
  ! Cache-Control
  Cache-Control: no-cache
/assets/poster.js
  ! Cache-Control
  Cache-Control: no-cache
/assets/panda.js
  ! Cache-Control
  Cache-Control: no-cache
/assets/studio.js
  ! Cache-Control
  Cache-Control: no-cache
/assets/store.js
  ! Cache-Control
  Cache-Control: no-cache
/assets/skill-logos.js
  ! Cache-Control
  Cache-Control: no-cache

/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/portal/*
  ! X-Frame-Options
  X-Frame-Options: DENY
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
