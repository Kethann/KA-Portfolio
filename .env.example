# Free API key from Google AI Studio (aistudio.google.com) -- no credit card required.
GEMINI_API_KEY=...
PORT=8787
# Optional on the first start; otherwise a random starter password is written privately.
# CREATOR_PASSWORD=choose-a-long-unique-passcode
# Mount this directory on a persistent volume when deploying.
# CREATOR_DATA_DIR=/persistent/ka-portfolio
# Set only behind your trusted reverse proxy when it terminates HTTPS.
# TRUST_PROXY=1
# Only needed if index.html is ALSO served as a static copy somewhere that can't run this server
# (e.g. GitHub Pages) -- set to that copy's exact origin (comma-separate more than one) so its
# API calls (see kaApiUrl()/KA_API_BASE at the very top of index.html, which you point at THIS
# server's own public URL in that static copy) are allowed through. Leave unset for a normal
# same-origin deployment (this server serving index.html itself) -- nothing changes.
# ALLOWED_ORIGIN=https://your-username.github.io
