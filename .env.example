# Free API key from Google AI Studio (aistudio.google.com) -- no credit card required.
GEMINI_API_KEY=...
PORT=8787
# Optional on the first start; otherwise a random starter password is written privately.
# CREATOR_PASSWORD=choose-a-long-unique-passcode
# Mount this directory on a persistent volume when deploying.
# CREATOR_DATA_DIR=/persistent/ka-portfolio
# Set only behind your trusted reverse proxy when it terminates HTTPS.
# TRUST_PROXY=1
