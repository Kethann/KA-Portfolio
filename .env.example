# Names only. On Cloudflare: public values go in wrangler.jsonc "vars"; secrets with
# `npx wrangler secret put NAME` (see docs/operations/CLOUDFLARE.md). Locally: a .env file. Never commit .env.
# PUBLIC = safe in the browser (it identifies, it can't authorize). SECRET = server only.

# ---- site
PUBLIC_SITE_URL=              # PUBLIC  e.g. https://kethanartzz.com (no trailing slash)
SITE_NAME=                    # PUBLIC  shown in emails, e.g. Kethan Artzz
OWNER_EMAIL=                  # SECRET  where new-message and report emails go
KA_ENV=                       # set to "production" on the live deployment only

# ---- database + files: nothing to set. Cloudflare uses the D1 (DB) and R2 (FILES) bindings in wrangler.jsonc;
#      locally the app uses .data/ka.sqlite and .data/storage.

# ---- email: Gmail with an App Password (Google Account -> Security -> App passwords). Emails are sent
#      from GMAIL_USER. Leave both empty locally to write emails to .data/outbox instead.
GMAIL_USER=                   # SECRET  e.g. kethanartzz@gmail.com
GMAIL_APP_PASSWORD=           # SECRET  the 16-letter App Password
BREVO_API_KEY=                # SECRET  optional alternative to Gmail
MAIL_FROM=                    # PUBLIC  sender address when using Brevo
MAIL_FROM_NAME=               # PUBLIC
MAIL_SIGNATURE=               # PUBLIC  optional closing line

# ---- bot protection (Cloudflare -> Turnstile)
TURNSTILE_SITE_KEY=           # PUBLIC
TURNSTILE_SECRET_KEY=         # SECRET

# ---- payments (Razorpay -> Account & Settings -> API keys / Webhooks)
RAZORPAY_KEY_ID=              # PUBLIC  rzp_test_... until everything passes, then rzp_live_...
RAZORPAY_KEY_SECRET=          # SECRET
RAZORPAY_WEBHOOK_SECRET=      # SECRET  the secret you type when creating the webhook

# ---- downloads, portal, jobs
DOWNLOAD_TOKEN_SECRET=        # SECRET  long random string (signs local links; rotate = old links stop)
ADMIN_ENCRYPTION_KEY=         # SECRET  long random string (encrypts the portal 2FA seed at rest)
ADMIN_SETUP_TOKEN=            # SECRET  one-time token for creating the owner account; remove after setup
CRON_SECRET=                  # SECRET  optional: lets you call /api/cron/* by hand (Cloudflare runs the jobs itself)

# ---- AI assistant (swappable provider)
AI_PROVIDER=                  # PUBLIC  gemini (default) or anthropic
AI_MODEL=                     # PUBLIC  optional model override
GEMINI_API_KEY=               # SECRET
ANTHROPIC_API_KEY=            # SECRET  only if AI_PROVIDER=anthropic

# ---- visitor location (IP-based estimate; typically city/ISP level, never street-accurate)
GEO_PROVIDER=                 # PUBLIC  auto (Cloudflare then external lookup), cloudflare, ipstack, or ipwhois
IPSTACK_ACCESS_KEY=           # SECRET  free plan = 100 lookups/month; GEO_PROVIDER=ipstack to prefer it
GEO_FALLBACK=                 # PUBLIC  legacy ipwhois toggle: ipwhois (default) or none; prefer GEO_PROVIDER

# ---- local development only
# PORT=9878
# KA_API_PORT=9878       # Vite's /api proxy target (match PORT if you change it)
# KA_DEMO_PAYMENTS=1     # local simulated checkout only; cannot enable in production or with Razorpay keys
# KA_DATA_DIR=.data           # local PGlite database, storage and email outbox
# KA_DEV_COUNTRY=IN           # pretend visitor country (tests INR/USD pricing)
# TURNSTILE_DISABLED=1        # ignored in production
# ALLOWED_ORIGINS=            # extra origins allowed to call the API (normally empty)

# Google Drive as a product's file source (Products > File buyers download > "use a Google Drive file").
# Optional: without it the public Drive download address is used, which works for files shared as "Anyone with the link".
# With a Google Cloud API key (Drive API enabled) downloads are more reliable for big files.
# GOOGLE_API_KEY=                # SECRET
